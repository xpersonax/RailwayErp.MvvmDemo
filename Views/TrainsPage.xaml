<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RailwayErp.MvvmDemo.ViewModels"
             xmlns:m="clr-namespace:RailwayErp.MvvmDemo.Models"
             x:Class="RailwayErp.MvvmDemo.Views.TrainsPage"
             x:DataType="vm:TrainsViewModel"
             Title="Потяги">

    <Grid RowDefinitions="Auto,Auto,*" Padding="16" RowSpacing="12">

        <!-- Форма додавання потяга -->
        <Border Grid.Row="0" Padding="12" StrokeShape="RoundRectangle 10">
            <VerticalStackLayout Spacing="8">
                <Label Text="Новий потяг" FontAttributes="Bold" FontSize="16" />
                <Grid ColumnDefinitions="*,*,80" ColumnSpacing="8">
                    <Entry Grid.Column="0" Placeholder="Номер (напр. 105К)" Text="{Binding NewNumber}" />
                    <Entry Grid.Column="1" Placeholder="Маршрут" Text="{Binding NewRoute}" />
                    <Entry Grid.Column="2" Placeholder="Вагонів" Keyboard="Numeric" Text="{Binding NewWagons}" />
                </Grid>
                <Button Text="Зберегти" Command="{Binding AddTrainCommand}" IsEnabled="{Binding IsNotBusy}" />
                <Label FontSize="12" TextColor="Gray"
                       Text="Підказка: номер, що починається з «ERR», імітує збій сховища (запис рівня ERR у лозі); порожні поля — WRN." />
            </VerticalStackLayout>
        </Border>

        <!-- Статус останньої операції -->
        <Label Grid.Row="1" Text="{Binding StatusMessage}" IsVisible="{Binding HasStatus}">
            <Label.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding StatusIsError}" Value="True">
                    <Setter Property="TextColor" Value="#C62828" />
                </DataTrigger>
                <DataTrigger TargetType="Label" Binding="{Binding StatusIsError}" Value="False">
                    <Setter Property="TextColor" Value="#2E7D32" />
                </DataTrigger>
            </Label.Triggers>
        </Label>

        <!-- Список потягів -->
        <RefreshView Grid.Row="2" Command="{Binding LoadCommand}" IsRefreshing="{Binding IsBusy}">
            <CollectionView ItemsSource="{Binding Trains}" SelectionMode="None">
                <CollectionView.EmptyView>
                    <Label Text="Потягів немає. Потягніть вниз, щоб оновити." HorizontalOptions="Center" Margin="0,24" />
                </CollectionView.EmptyView>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="m:Train">
                        <Grid ColumnDefinitions="*,Auto" Padding="4,8" ColumnSpacing="8">
                            <VerticalStackLayout Grid.Column="0" Spacing="2">
                                <Label FontAttributes="Bold" FontSize="16">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Number}" />
                                            <Span Text="  ·  " />
                                            <Span Text="{Binding Route}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                                <Label FontSize="13" TextColor="Gray">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding Wagons}" />
                                            <Span Text=" вагонів · " />
                                            <Span Text="{Binding StatusText}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                            <Button Grid.Column="1" Text="✕" WidthRequest="44" Padding="0"
                                    BackgroundColor="Transparent" TextColor="#C62828"
                                    Command="{Binding DeleteTrainCommand, Source={RelativeSource AncestorType={x:Type vm:TrainsViewModel}}, x:DataType=vm:TrainsViewModel}"
                                    CommandParameter="{Binding .}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>
